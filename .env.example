# Required
OPENAI_API_KEY=
# Required in production: random string, 32+ chars (signs the chat state)
STATE_SECRET=
# Optional
OPENAI_MODEL=gpt-5.6-luna
DAILY_BUDGET_USD=1.0
VISITOR_HOURLY_LIMIT=20
# Upstash Redis REST (required in production; unset = in-memory counters for local dev)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: private feedback messages allowed per visitor per day (spec 02)
FEEDBACK_DAILY_LIMIT=3
